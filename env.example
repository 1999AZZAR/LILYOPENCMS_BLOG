# =============================================================================
# Environment variables for docker-compose
# Copy this to .env and fill in values before running `docker compose up`
# =============================================================================

# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-hex-string

# PostgreSQL
POSTGRES_DB=lilycms
POSTGRES_USER=lily
POSTGRES_PASSWORD=lily_secret
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# App
APP_PORT=5000

# Elasticsearch (for Argus + Cerebro)
ELASTICSEARCH_PORT=9200

# Sidecars
ARGUS_PORT=50051
HERMES_PORT=50052
CEREBRO_PORT=8080
